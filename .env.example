# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql://clinic_care:CHANGE_ME@localhost:5432/clinic_care
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to let other computers on the clinic network connect.
HOST=127.0.0.1
TZ=Africa/Nairobi
# Set to production when served over HTTPS, so session cookies are marked Secure.
NODE_ENV=development
